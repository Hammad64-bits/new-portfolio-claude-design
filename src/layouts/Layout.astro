---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hammad Habib — Software Engineer",
  description = "Software engineer with deep frontend experience, working across product, architecture and systems.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>html { background: #0a0a0a; }</style>
    <!-- Flags JS before first paint so CSS-defined scroll scenes (global.css) never
         flash between their static and cinematic layouts. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="main" class="min-h-screen overflow-x-hidden bg-ink">
    <div id="cursor" aria-hidden="true"></div>
    <slot />

    <button
      type="button"
      data-scroll-top
      aria-label="Scroll to top"
      class="fixed right-5 bottom-5 z-40 flex h-11 w-11 items-center justify-center rounded-[2px] border border-[#2b2b28] bg-[#0a0a0a]/90 text-[#9c9a94] backdrop-blur-[6px] hover:border-accent hover:text-accent focus-visible:border-accent focus-visible:text-accent focus-visible:outline-none sm:right-8 sm:bottom-8"
    >
      <span aria-hidden="true" class="font-mono text-base leading-none">↑</span>
    </button>

    <div id="hh-page-transition" class="page-transition-loader" aria-hidden="true" style="display:none">
      <svg class="page-transition-loader__corners" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
        <path data-loader-frame class="page-transition-loader__stroke page-transition-loader__stroke--black" d="M55 168V52H184 M816 52H945V168 M55 432V548H184 M816 548H945V432" />
        <path data-loader-frame class="page-transition-loader__stroke page-transition-loader__stroke--white" d="M62 176V60H191 M809 60H938V176 M62 424V540H191 M809 540H938V424" />
      </svg>
      <div class="page-transition-loader__content" data-loader-content>
        <span class="page-transition-loader__word" aria-label="Loading.">
          {Array.from("Loading.").map((letter) => <span data-loader-letter aria-hidden="true">{letter}</span>)}
        </span>
        <span class="page-transition-loader__underlines" aria-hidden="true">
          <span data-loader-underline class="page-transition-loader__underline page-transition-loader__underline--black"></span>
          <span data-loader-underline class="page-transition-loader__underline page-transition-loader__underline--white"></span>
        </span>
      </div>
    </div>
  </body>
</html>

<script>
  import { initMotion } from "../scripts/motion";
  import "../scripts/cursor";
  initMotion();
  
</script>
