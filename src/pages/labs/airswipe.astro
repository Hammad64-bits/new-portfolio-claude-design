---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const questions = [
  "what counts as intentional movement?",
  "how much movement is enough?",
  "how should noisy input be smoothed?",
  "when should a gesture begin/end?",
  "how should accidental triggers be avoided?",
];
---

<Layout title="AirSwipe — Hammad Habib" description="A small computer-vision experiment that turns webcam-detected hand movement into desktop input — an interaction-design problem more than a mouse replacement.">
  <div class="min-h-screen overflow-x-hidden bg-ink">
    <Header active="labs" />

    <section class="mx-auto max-w-[1000px] px-5 pt-11 pb-7 sm:px-8 sm:pt-15 lg:px-16 lg:pt-22">
      <a href="/labs" class="font-mono text-[11.5px] tracking-[.12em] text-[#8c8a84] uppercase hover:text-accent">← Labs</a>
      <div class="mt-6 flex flex-wrap items-center gap-[10px]">
        <span class="rounded-full border border-[#2b2b28] px-[11px] py-[5px] font-mono text-[10px] tracking-[.1em] text-[#cfcdc6] uppercase">Experiment</span>
        <span class="font-mono text-[10.5px] tracking-[.12em] text-[#8c8a84] uppercase">Computer Vision / Interaction</span>
      </div>
      <h1 class="mt-[22px] max-w-[22ch] text-[clamp(28px,3.8vw,50px)] leading-[1.08] font-medium tracking-[-.035em] text-wrap-pretty">AirSwipe</h1>
      <p class="mt-[18px] max-w-[52ch] text-[clamp(16px,1.4vw,20px)] leading-[1.6] tracking-[-.015em] text-[#dedbd4] text-wrap-pretty">
        What if scrolling a computer meant waving at it? AirSwipe is a small Python / computer-vision experiment that turns webcam-detected hand movement into desktop input.
      </p>
      <p class="mt-4 max-w-[52ch] text-[15px] leading-[1.7] text-[#a7a59e]">
        It is less about replacing the mouse and more about exploring what an interface feels like when the pointer is your hand.
      </p>
      <span class="mt-6 block font-mono text-[13px] leading-[1.9] tracking-[.02em] text-[#a7a59e]">Python · Computer Vision · Desktop Input</span>
    </section>

    <section class="mx-auto max-w-[1000px] px-5 pb-9 sm:px-8 lg:px-16 lg:pb-14">
      <div class="texture-hatch flex aspect-video items-end border border-[#1e1e1c] p-4">
        <span class="font-mono text-[10.5px] tracking-[.1em] text-[#6e6c67] uppercase">Demo clip — hand tracking driving desktop scroll (asset needed, if a demo exists)</span>
      </div>
    </section>

    <section class="mx-auto flex max-w-[1000px] flex-col gap-9 px-5 pb-10 sm:px-8 lg:px-16 lg:gap-14 lg:pb-16">
      <div class="flex flex-col gap-4">
        <span class="font-mono text-[11px] tracking-[.14em] text-[#8c8a84] uppercase">Why</span>
        <p class="m-0 max-w-[62ch] text-[15.5px] leading-[1.8] text-[#a7a59e]">
          Most web interaction experiments still assume mouse, keyboard, touch. I wanted to play with a messier input device: a human hand moving in front of a webcam.
        </p>
      </div>

      <div class="flex flex-col gap-4">
        <span class="font-mono text-[11px] tracking-[.14em] text-[#8c8a84] uppercase">Basic idea</span>
        <div class="flex flex-col gap-[2px] border border-dashed border-[#2b2b28] p-5 font-mono text-[11.5px] leading-[1.6] text-[#8c8a84] sm:p-8">
          <span class="text-paper">webcam frame</span>
          <span class="text-[#3a3a36]">↓</span>
          <span class="text-[#cfcdc6]">detect / track hand movement</span>
          <span class="text-[#3a3a36]">↓</span>
          <span class="text-[#cfcdc6]">interpret gesture</span>
          <span class="text-[#3a3a36]">↓</span>
          <span class="text-[#cfcdc6]">map gesture to an action</span>
          <span class="text-[#3a3a36]">↓</span>
          <span class="text-paper">send desktop input</span>
          <span class="mt-3 text-[10.5px] tracking-[.1em] text-[#6e6c67] uppercase">The interesting gap is between detection and interaction. A raw movement signal is not automatically a usable control.</span>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="font-mono text-[11px] tracking-[.14em] text-[#8c8a84] uppercase">The interaction problem</span>
        <p class="m-0 max-w-[62ch] text-[15.5px] leading-[1.8] text-[#a7a59e]">
          Physical input is noisy. Hands drift. Detection jumps. People pause halfway through gestures. Tiny accidental movement should not make the desktop go berserk. That turns a computer-vision toy into an interaction-design problem:
        </p>
        <div class="flex flex-col">
          {questions.map((q, i) => (
            <span class:list={["border-t border-[#1e1e1c] py-[14px] text-[14.5px] leading-[1.6] text-[#a7a59e]", i === questions.length - 1 && "border-b"]}>{q}</span>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="font-mono text-[11px] tracking-[.14em] text-[#8c8a84] uppercase">Status</span>
        <p class="m-0 max-w-[62ch] text-[15.5px] leading-[1.8] text-[#a7a59e]">
          Treat this honestly as an experiment, not a finished accessibility product or production input system. Its value in the portfolio is the exploration: computer vision → signal interpretation → human interaction.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-[1000px] border-t border-[#1e1e1c] px-5 py-9 sm:px-8 lg:px-16 lg:py-16">
      <span class="font-mono text-[11px] tracking-[.14em] text-[#8c8a84] uppercase">Related Work</span>
      <a href="/labs/courtpal" class="mt-5 flex flex-wrap items-end justify-between gap-5 border border-[#1e1e1c] p-5 hover:border-[#5a5a54] sm:p-7">
        <span class="flex min-w-0 flex-col gap-[10px]">
          <span class="font-mono text-[10.5px] tracking-[.12em] text-[#8c8a84] uppercase">CourtPal · lab</span>
          <span class="max-w-[26ch] text-[clamp(18px,2vw,26px)] leading-[1.2] tracking-[-.025em] text-wrap-pretty">A different kind of interface boundary — deciding what an AI agent is allowed to control, instead of what a hand gesture is allowed to trigger.</span>
        </span>
        <span class="font-mono text-[11.5px] tracking-[.12em] text-accent uppercase">Open lab →</span>
      </a>
    </section>

    <Footer />
  </div>
</Layout>
