---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const vigilantPills = ["Diagnosis", "Incident response", "Migration", "Performance"];

const capabilities = [
  { title: "Product Engineering", stack: "Next.js · Supabase · Postgres" },
  { title: "Frontend & Interaction", stack: "React · TypeScript · Astro" },
  { title: "Systems & Architecture", stack: "Realtime · Webhooks · OAuth" },
  { title: "Performance & Debugging", stack: "Linux · SSH · SEO · Profiling" },
];
---

<Layout title="Work — Hammad Habib" description="Two projects, both still in production: an AI customer-support SaaS built from the inside, and a legacy system diagnosed, secured and rebuilt.">
  <div class="min-h-screen overflow-x-hidden bg-ink">
    <Header active="work" />

    <section id="top" class="mx-auto max-w-[1440px] px-5 pt-12 pb-9 sm:px-8 sm:pt-16 sm:pb-12 lg:px-16 lg:pt-24 lg:pb-15">
      <div class="flex items-center gap-[14px] font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
        <span class="block h-px w-[26px] bg-[#3a3a36]"></span>
        <span>Work</span>
      </div>
      <h1 class="mt-6 max-w-[24ch] text-[clamp(28px,4vw,54px)] leading-[1.08] font-medium tracking-[-.035em] text-wrap-pretty">
        Two projects, both still in production.
      </h1>
      <p class="mt-5 max-w-[50ch] text-[clamp(15px,1.2vw,17.5px)] leading-[1.65] text-[#a7a59e] text-wrap-pretty">
        One is a SaaS product I helped build from the inside. The other is a legacy system I had to diagnose, secure and rebuild without losing what it was already worth.
      </p>
    </section>

    <section class="mx-auto max-w-[1440px] px-5 pb-14 sm:px-8 lg:px-16 lg:pb-25">
      <a href="/work/revsmith" class="block border-t border-[#2b2b28] pt-6 lg:pt-10">
        <div class="flex flex-wrap items-baseline justify-between gap-4 font-mono text-[11.5px] tracking-[.12em] text-[#8c8a84] uppercase">
          <span class="text-paper">01 — RevSmith</span>
          <span>2024—2025 · Software Engineer · Product</span>
        </div>
        <h2 class="mt-5 max-w-[26ch] text-[clamp(26px,3.6vw,50px)] leading-[1.1] font-medium tracking-[-.035em] text-wrap-pretty lg:mt-9">
          An AI customer-support platform, built inside a small startup team.
        </h2>
        <div class="relative mt-6 aspect-video overflow-hidden border border-[#1e1e1c] bg-[#050505] lg:mt-10">
          <video
            src="/revsmith/revsmith-demo.mp4"
            poster="/revsmith/posters/revsmith-demo.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            class="absolute inset-0 h-full w-full object-cover object-top"
          ></video>
          <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(5,5,5,0)_60%,rgba(5,5,5,.85))]"></div>
          <span class="absolute bottom-4 left-4 font-mono text-[10.5px] tracking-[.12em] text-[#cfcdc6] uppercase">Support inbox — full bleed</span>
        </div>
        <div class="mt-[22px] flex flex-wrap items-baseline justify-between gap-6">
          <p class="m-0 max-w-[52ch] text-[15px] leading-[1.7] text-[#a7a59e]">
            Widget, omnichannel inbox, AI agent configuration and the WhatsApp channel — frontend ownership that grew into APIs, realtime, auth and architecture.
          </p>
          <span class="font-mono text-[11.5px] tracking-[.12em] text-accent uppercase">Read the case study →</span>
        </div>
      </a>
    </section>

    <section class="border-t border-b border-[#1e1e1c] bg-[#070707] py-14 sm:py-16 lg:py-24">
      <a href="/work/vigilant-security" class="mx-auto block max-w-[1440px] px-5 sm:px-8 lg:px-16">
        <div class="flex flex-wrap items-baseline justify-between gap-4 font-mono text-[11.5px] tracking-[.12em] text-[#8c8a84] uppercase">
          <span class="text-paper">02 — Vigilant Security / SolvoLab</span>
          <span>2023—2024 · UK / Ireland</span>
        </div>

        <div class="mt-6 flex flex-wrap items-start gap-7 lg:mt-10 lg:gap-14">
          <div class="flex min-w-0 flex-1 basis-[380px] flex-col gap-[22px]">
            <h2 class="m-0 max-w-[24ch] text-[clamp(24px,3.2vw,44px)] leading-[1.12] font-medium tracking-[-.035em] text-wrap-pretty">
              Modernising production websites without throwing away years of SEO value.
            </h2>
            <p class="m-0 max-w-[48ch] text-[15px] leading-[1.7] text-[#a7a59e]">
              Legacy WordPress, diagnosed over SSH. A real security incident handled mid-project. Rebuilt on Astro and Sanity across two regional sites, rankings intact.
            </p>
            <div class="flex flex-wrap gap-px border border-[#1e1e1c] bg-[#1e1e1c]">
              {vigilantPills.map((pill) => (
                <span class="flex-1 basis-[120px] bg-[#070707] p-4 font-mono text-[11px] tracking-[.06em] text-[#cfcdc6]">{pill}</span>
              ))}
            </div>
            <span class="font-mono text-[11.5px] tracking-[.12em] text-accent uppercase">Read the case study →</span>
          </div>

          <div class="flex min-w-0 flex-1 basis-[300px] flex-col gap-3">
            <div class="relative aspect-4/3 overflow-hidden border border-[#1e1e1c] bg-[#050505]">
              <img src="/vigilant/new-service-page.png" alt="New Vigilant Security site on Astro and Sanity" class="absolute inset-0 h-full w-full object-cover object-top" loading="lazy" />
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(5,5,5,0)_55%,rgba(5,5,5,.85))]"></div>
              <span class="absolute bottom-3 left-3 font-mono text-[10.5px] tracking-[.1em] text-[#cfcdc6] uppercase">New site — UK</span>
            </div>
            <div class="relative aspect-video overflow-hidden border border-[#1e1e1c] bg-[#050505]">
              <img src="/vigilant/legacy-uk.png" alt="Legacy Vigilant Security WordPress site" class="absolute inset-0 h-full w-full object-cover object-top" loading="lazy" />
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(5,5,5,0)_55%,rgba(5,5,5,.85))]"></div>
              <span class="absolute bottom-3 left-3 font-mono text-[10.5px] tracking-[.1em] text-[#cfcdc6] uppercase">Legacy WordPress — before</span>
            </div>
          </div>
        </div>
      </a>
    </section>

    <section class="mx-auto max-w-[1440px] px-5 py-14 sm:px-8 lg:px-16 lg:py-25">
      <div class="flex flex-wrap items-baseline justify-between gap-4 font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
        <span class="text-paper">Capabilities</span>
        <span>What the work above required</span>
      </div>
      <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6 lg:mt-13 lg:gap-11">
        {capabilities.map((c, i) => (
          <div class="flex flex-col gap-[10px] border-t border-[#2b2b28] pt-5">
            <span class="font-mono text-[10.5px] text-[#6e6c67]">{String(i + 1).padStart(2, "0")}</span>
            <span class="text-[clamp(16px,1.4vw,19px)] tracking-[-.02em]">{c.title}</span>
            <span class="font-mono text-[10.5px] tracking-[.06em] text-[#6e6c67]">{c.stack}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-[1440px] border-t border-[#1e1e1c] px-5 py-14 sm:px-8 lg:px-16 lg:py-26">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <h2 class="m-0 max-w-[24ch] flex-1 basis-[400px] text-[clamp(24px,3vw,42px)] leading-[1.12] font-medium tracking-[-.03em] text-wrap-pretty">
          Hiring, building, or stuck on something that should work. Start there.
        </h2>
        <div class="flex flex-wrap gap-[14px]">
          <a href="/contact" class="inline-flex items-center gap-[10px] rounded-[2px] bg-paper px-[22px] py-[14px] text-[14.5px] font-medium text-ink hover:bg-accent">
            Get in touch →
          </a>
          <a href="/labs" class="inline-flex items-center gap-[10px] rounded-[2px] border border-[#2b2b28] px-[22px] py-[14px] text-[14.5px] text-[#cfcdc6] hover:border-[#5a5a54] hover:text-paper">
            See the Labs
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
