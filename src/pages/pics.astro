---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const picsDir = path.join(process.cwd(), "public/images/pics");
const files = fs
  .readdirSync(picsDir)
  .filter((f) => /\.(jpe?g|png)$/i.test(f))
  .sort((a, b) => a.localeCompare(b));

function labelFor(filename: string) {
  const base = filename.replace(/\.[^.]+$/, "");
  const words = base
    .replace(/[-_]+/g, " ")
    .replace(/\d+/g, "")
    .trim();
  const title = words
    .split(" ")
    .filter(Boolean)
    .map((w) => w[0].toUpperCase() + w.slice(1))
    .join(" ");
  return title || "Photograph";
}

const photos = files.map((f, i) => ({
  src: `/images/pics/${f}`,
  label: labelFor(f),
  index: i,
}));

function spanClass(i: number) {
  const m = i % 13;
  if (m === 0) return "span-2x2";
  if (m === 6) return "span-2x1";
  if (m === 9) return "span-1x2";
  return "";
}
---

<Layout
  title="Pics — Hammad Habib"
  description={`${photos.length} photographs — the full set, not the curated six.`}
>
  <div class="min-h-screen overflow-x-hidden bg-ink">
    <Header active="pics" />

    <section class="mx-auto max-w-[1440px] px-5 pt-12 pb-8 sm:px-8 sm:pt-16 sm:pb-11 lg:px-16 lg:pt-20">
      <a href="/about" class="font-mono text-[11.5px] tracking-[.12em] text-[#8c8a84] uppercase hover:text-accent">← About</a>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
        <h1 class="m-0 max-w-[20ch] text-[clamp(28px,4.2vw,56px)] leading-[1.06] font-medium tracking-[-.035em] text-wrap-pretty">
          All the frames, not just the six.
        </h1>
        <span class="font-mono text-[11.5px] tracking-[.1em] text-[#6e6c67] uppercase">{photos.length} photographs · click to view</span>
      </div>
    </section>

    <section class="px-5 pb-16 sm:px-8 lg:px-16 lg:pb-28">
      <div class="bento" data-pics-grid>
        {photos.map((photo) => (
          <button
            type="button"
            class:list={["bento-item", spanClass(photo.index)]}
            data-pics-item
            data-src={photo.src}
            data-alt={photo.label}
            aria-label={`Open photograph: ${photo.label}`}
          >
            <img src={photo.src} alt={photo.label} loading="lazy" decoding="async" />
            <span class="bento-index" aria-hidden="true">{String(photo.index + 1).padStart(2, "0")}</span>
          </button>
        ))}
      </div>
    </section>

    <Footer />
  </div>

  <div id="pics-lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <button type="button" class="lightbox-btn lightbox-close" data-lb-close aria-label="Close">✕</button>
    <button type="button" class="lightbox-btn lightbox-prev" data-lb-prev aria-label="Previous photograph">←</button>
    <button type="button" class="lightbox-btn lightbox-next" data-lb-next aria-label="Next photograph">→</button>
    <img id="pics-lightbox-img" alt="" />
    <div class="lightbox-meta">
      <span id="pics-lightbox-counter"></span>
    </div>
  </div>
</Layout>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    grid-auto-rows: clamp(110px, 14vw, 190px);
    gap: 3px;
    background: #1e1e1c;
    border: 1px solid #1e1e1c;
  }
  .bento-item {
    position: relative;
    overflow: hidden;
    display: block;
    margin: 0;
    padding: 0;
    border: none;
    background: #050505;
    cursor: zoom-in;
  }
  .bento-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.18) contrast(1.02);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s ease;
  }
  .bento-item:hover img,
  .bento-item:focus-visible img {
    transform: scale(1.045);
    filter: none;
  }
  .bento-item:focus-visible {
    outline: 2px solid #b9ff4d;
    outline-offset: -2px;
  }
  .bento-index {
    position: absolute;
    top: 8px;
    left: 8px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #eeece6;
    opacity: 0;
    transition: opacity 0.25s ease;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }
  .bento-item:hover .bento-index,
  .bento-item:focus-visible .bento-index {
    opacity: 1;
  }
  .span-2x2 { grid-column: span 2; grid-row: span 2; }
  .span-2x1 { grid-column: span 2; }
  .span-1x2 { grid-row: span 2; }

  @media (max-width: 640px) {
    .span-2x2, .span-2x1 { grid-column: span 2; }
    .span-1x2 { grid-row: span 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-item img { transition: none; }
    .bento-item:hover img, .bento-item:focus-visible img { transform: none; }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(5, 5, 5, 0.97);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox img {
    max-width: 90vw;
    max-height: 86vh;
    object-fit: contain;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
    transition: opacity 0.15s ease;
  }
  .lightbox-btn {
    position: absolute;
    background: rgba(10, 10, 10, 0.6);
    border: 1px solid #2b2b28;
    color: #eeece6;
    font-family: "IBM Plex Mono", monospace;
    font-size: 15px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .lightbox-btn:hover {
    border-color: #5a5a54;
    color: #b9ff4d;
  }
  .lightbox-close {
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
  }
  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
  }
  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  .lightbox-meta {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #8c8a84;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox img { transition: none; }
  }

  @media (max-width: 640px) {
    .lightbox-prev, .lightbox-next { width: 40px; height: 40px; font-size: 13px; }
    .lightbox-close { width: 36px; height: 36px; }
  }
</style>
