---
import Layout from "../layouts/Layout.astro";
import ContactPageContent from "../components/ContactPageContent.astro";
---

<Layout title="Contact — Hammad Habib" description="Hiring, a freelance build, or a production problem that should be simple and isn't. Get in touch.">
  <div class="flex min-h-screen flex-col overflow-x-clip bg-ink">
    <ContactPageContent />
  </div>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const st = (trigger: Element, start = "top 82%") => ({ trigger, start, once: true });

  const headerEls = [
    document.querySelector("[data-ci-eyebrow]"),
    document.querySelector("[data-ci-heading]"),
    document.querySelector("[data-ci-desc]"),
  ].filter(Boolean) as Element[];

  if (headerEls.length) {
    gsap.from(headerEls, { y: 28, autoAlpha: 0, duration: 0.7, stagger: 0.14, ease: "power3.out", scrollTrigger: st(headerEls[0]) });
  }

  const formCol = document.querySelector("[data-ci-form]");
  if (formCol) {
    gsap.from(formCol, { x: -48, autoAlpha: 0, duration: 0.8, ease: "power2.out", scrollTrigger: st(formCol, "top 78%") });
  }

  const video = document.querySelector("[data-ci-video]");
  if (video) {
    gsap.from(video, { x: 48, autoAlpha: 0, duration: 0.8, ease: "power2.out", scrollTrigger: st(video, "top 78%") });
  }

  const ciLinks = Array.from(document.querySelectorAll("[data-ci-link]"));
  if (ciLinks.length) {
    gsap.from(ciLinks, { x: -24, autoAlpha: 0, duration: 0.5, stagger: 0.09, ease: "power2.out", scrollTrigger: st(ciLinks[0]) });
  }

  document.fonts?.ready.then(() => ScrollTrigger.refresh());
</script>
