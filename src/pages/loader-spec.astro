---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Loading Card — Interaction Spec" description="Visual reference for the lime page transition loader.">
  <div id="top" class="min-h-screen overflow-x-hidden bg-ink">
    <header class="border-b border-[#1e1e1c]">
      <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-8 px-5 py-[18px] sm:px-8 lg:px-16">
        <a href="/" class="text-[19px] font-semibold tracking-[-.02em]">Hammad<span class="text-accent">.</span></a>
        <a href="/work" class="font-mono text-[11.5px] tracking-[.12em] text-[#9c9a94] uppercase hover:text-paper">Back to work →</a>
      </div>
    </header>

    <section class="mx-auto max-w-[1440px] px-5 pt-11 pb-8 sm:px-8 sm:pt-16 sm:pb-10 lg:px-16 lg:pt-20 lg:pb-13">
      <div class="flex items-center gap-[14px] font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
        <span class="block h-px w-[26px] bg-[#3a3a36]"></span>
        <span>Page transition · Loading card</span>
      </div>
      <h1 class="mt-6 max-w-[24ch] text-[clamp(28px,3.8vw,52px)] leading-[1.08] font-medium tracking-[-.035em] text-wrap-pretty">
        A bright loading card, drawn like it belongs on paper.
      </h1>
      <p class="mt-5 max-w-[54ch] text-[15px] leading-[1.7] text-[#a7a59e]">
        The lime field reveals from left to right, framing a hand-lettered “Loading.” with loose black and white corner marks.
      </p>
    </section>

    <section class="mx-auto max-w-[1440px] px-5 pb-14 sm:px-8 lg:px-16 lg:pb-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4 font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
        <span class="text-paper">01 / Visual</span>
        <span>Reference composition</span>
      </div>

      <div class="loader-preview relative mt-6 aspect-video min-h-[320px] overflow-hidden border border-[#1e1e1c] bg-accent">
        <svg class="page-transition-loader__corners" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
          <path class="page-transition-loader__stroke page-transition-loader__stroke--black" d="M55 168V52H184 M816 52H945V168 M55 432V548H184 M816 548H945V432" />
          <path class="page-transition-loader__stroke page-transition-loader__stroke--white" d="M62 176V60H191 M809 60H938V176 M62 424V540H191 M809 540H938V424" />
        </svg>
        <div class="page-transition-loader__content">
          <span class="page-transition-loader__word">
            {Array.from("Loading.").map((letter) => <span>{letter}</span>)}
          </span>
          <span class="page-transition-loader__underlines" aria-hidden="true">
            <span class="page-transition-loader__underline page-transition-loader__underline--black"></span>
            <span class="page-transition-loader__underline page-transition-loader__underline--white"></span>
          </span>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1440px] border-t border-[#1e1e1c] px-5 py-12 sm:px-8 lg:px-16 lg:py-22">
      <div class="font-mono text-[11.5px] tracking-[.14em] text-paper uppercase">02 / Spec</div>
      <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        <div class="border-t border-[#2b2b28] pt-4">
          <div class="font-mono text-[11px] tracking-[.12em] text-[#8c8a84] uppercase">Field</div>
          <div class="mt-3 text-sm text-[#dedbd4]">Accent lime · #B9FF4D</div>
        </div>
        <div class="border-t border-[#2b2b28] pt-4">
          <div class="font-mono text-[11px] tracking-[.12em] text-[#8c8a84] uppercase">Lettering</div>
          <div class="mt-3 text-sm text-[#dedbd4]">Caveat Bold · white ink with dark shadow</div>
        </div>
        <div class="border-t border-[#2b2b28] pt-4">
          <div class="font-mono text-[11px] tracking-[.12em] text-[#8c8a84] uppercase">Frame</div>
          <div class="mt-3 text-sm text-[#dedbd4]">Loose black and white corner strokes</div>
        </div>
        <div class="border-t border-[#2b2b28] pt-4">
          <div class="font-mono text-[11px] tracking-[.12em] text-[#8c8a84] uppercase">Motion</div>
          <div class="mt-3 text-sm text-[#dedbd4]">Reveal, frame, lettering, then two strokes · ~1.9s</div>
        </div>
      </div>
      <p class="mt-8 max-w-[58ch] text-[13.5px] leading-[1.65] text-[#a7a59e]">
        This is a short navigation transition, not a fake progress indicator. Reduced-motion preferences skip it and navigate immediately.
      </p>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  .loader-preview {
    position: relative;
    background: var(--color-accent);
  }
</style>
