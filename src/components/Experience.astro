---
const rows = [
  {
    period: "2021—2022",
    title: "Self-taught / HTML & CSS",
    body: "Pixel-perfect reproduction work. Learning to see layout properly.",
  },
  {
    period: "2022—2023",
    title: "React / Frontend work",
    body: "Component systems, state, real interfaces for real users.",
  },
  {
    period: "2023",
    title: "Intern → RevSmith",
    body: "First production codebase. Shipping inside a startup team.",
  },
  {
    period: "2024—2025",
    title: "Frontend Engineer, RevSmith",
    body: "Widget, inbox, AI agent config, Meta integrations, realtime, auth.",
  },
  {
    period: "2025—now",
    title: "SolvoLab",
    body: "Client and product work: migrations, performance, servers, SEO.",
    last: true,
  },
];
---

<!-- Scene 04. Rows brighten as they cross the focal band (scenes/experience.ts). -->
<section data-scene="experience" class="exp-scene mx-auto max-w-[1440px] border-t border-[#1e1e1c] px-5 py-16 sm:px-8 lg:px-16 lg:py-24">
  <div data-exp-bar class="flex flex-wrap items-baseline justify-between gap-6 font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
    <span class="text-paper">03 / Experience</span>
    <span>Short version</span>
  </div>

  <div class="exp-list relative mt-7 flex flex-col lg:mt-11">
    <span data-exp-progress aria-hidden="true" class="exp-progress"></span>
    {rows.map((row) => (
      <div
        data-exp-row
        class:list={[
          "exp-row grid grid-cols-[minmax(84px,.5fr)_minmax(0,1.6fr)] items-baseline gap-x-4 gap-y-1.5 border-t border-[#1e1e1c] py-5 md:grid-cols-[minmax(110px,.5fr)_minmax(160px,1.1fr)_minmax(200px,1.6fr)] md:gap-8",
          row.last && "border-b",
        ]}
      >
        <span class="font-mono text-[11.5px] tracking-[.06em] text-[#8c8a84]">{row.period}</span>
        <span data-exp-title class="exp-title origin-left text-[15.5px] tracking-[-.01em]">{row.title}</span>
        <span class="col-start-2 text-sm leading-[1.6] text-[#a7a59e] md:col-start-auto">{row.body}</span>
      </div>
    ))}
  </div>
</section>
