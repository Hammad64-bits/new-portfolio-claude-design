---
const rows = [
  {
    period: "2023",
    title: "Software Engineering Intern · RevSmith",
    body: "Shipped production features as the team built its first AI product and moved into ecommerce support.",
  },
  {
    period: "2024—2025",
    title: "Frontend Engineer · RevSmith",
    body: "Owned the customer-facing widget and support inbox, then took on integrations, realtime workflows, authentication, and data access.",
  },
  {
    period: "2025—Present",
    title: "Client & Product Engineering · SolvoLab",
    body: "Building and improving production websites and client systems across migrations, performance, infrastructure, and technical SEO.",
    last: true,
  },
];
---

<!-- Scene 04. Rows brighten as they cross the focal band (scenes/experience.ts). -->
<section data-scene="experience" class="exp-scene mx-auto max-w-[1440px] border-t border-[#1e1e1c] px-5 py-16 sm:px-8 lg:px-16 lg:py-24">
  <div data-exp-bar class="home-kicker flex flex-wrap items-baseline justify-between gap-6 font-mono tracking-[.14em] uppercase">
    <span class="text-paper">03 / Experience</span>
    <span>Professional work</span>
  </div>

  <div class="exp-list relative mt-7 flex flex-col lg:mt-11">
    <span data-exp-progress aria-hidden="true" class="exp-progress"></span>
    {rows.map((row) => (
      <div
        data-exp-row
        class:list={[
          "exp-row grid grid-cols-[minmax(84px,.5fr)_minmax(0,1.6fr)] items-baseline gap-x-4 gap-y-2 border-t border-[#1e1e1c] py-7 md:grid-cols-[minmax(130px,.45fr)_minmax(260px,1.15fr)_minmax(280px,1.5fr)] md:gap-8",
          row.last && "border-b",
        ]}
      >
        <span class="home-meta font-mono tracking-[.04em]">{row.period}</span>
        <span data-exp-title class="exp-title origin-left text-[clamp(17px,1.4vw,20px)] leading-[1.35] font-medium tracking-[-.015em]">{row.title}</span>
        <span class="col-start-2 text-base leading-[1.6] text-[#c3c1ba] md:col-start-auto">{row.body}</span>
      </div>
    ))}
  </div>
</section>
