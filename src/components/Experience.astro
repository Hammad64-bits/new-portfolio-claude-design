---
const rows = [
  {
    period: "2021—2022",
    title: "Self-taught / HTML & CSS",
    body: "Pixel-perfect reproduction work. Learning to see layout properly.",
  },
  {
    period: "2022—2023",
    title: "React / Frontend work",
    body: "Component systems, state, real interfaces for real users.",
  },
  {
    period: "2023",
    title: "Intern → RevSmith",
    body: "First production codebase. Shipping inside a startup team.",
  },
  {
    period: "2024—2025",
    title: "Frontend Engineer, RevSmith",
    body: "Widget, inbox, AI agent config, Meta integrations, realtime, auth.",
  },
  {
    period: "2025—now",
    title: "SolvoLab",
    body: "Client and product work: migrations, performance, servers, SEO.",
    last: true,
  },
];
---

<section class="mx-auto max-w-[1440px] border-t border-[#1e1e1c] px-5 py-16 sm:px-8 lg:px-16 lg:py-24">
  <div data-reveal class="flex flex-wrap items-baseline justify-between gap-6 font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
    <span class="text-paper">03 / Experience</span>
    <span>Short version</span>
  </div>

  <div data-reveal-group class="mt-7 flex flex-col lg:mt-11">
    {rows.map((row) => (
      <div
        data-reveal-item
        class:list={[
          "grid grid-cols-[minmax(110px,.5fr)_minmax(160px,1.1fr)_minmax(200px,1.6fr)] items-baseline gap-4 border-t border-[#1e1e1c] py-5 sm:gap-8",
          row.last && "border-b",
        ]}
      >
        <span class="font-mono text-[11.5px] tracking-[.06em] text-[#8c8a84]">{row.period}</span>
        <span class="text-[15.5px] tracking-[-.01em]">{row.title}</span>
        <span class="text-sm leading-[1.6] text-[#a7a59e]">{row.body}</span>
      </div>
    ))}
  </div>
</section>
