---
const labs = [
  {
    video: "iphone_blob",
    driftSeconds: 26,
    tag: "Lab 01 · Agents",
    title: "CourtPal — WhatsApp booking agent",
    aspect: "aspect-video",
    grow: "flex-[2_1_480px]",
    opacity: "opacity-90",
  },
  {
    video: "green_boxes",
    driftSeconds: 20,
    tag: "Lab 02 · Dev Tools",
    title: "Git-to-CV — career evidence from Git",
    aspect: "aspect-square",
    grow: "flex-1 basis-[240px]",
    opacity: "opacity-55",
  },
  {
    video: "orange_boxes",
    driftSeconds: 24,
    tag: "Lab 03 · Automation",
    title: "Waqas Work Bot — browser automation",
    aspect: "aspect-square",
    grow: "flex-1 basis-[240px]",
    opacity: "opacity-75",
  },
  {
    video: "orange_circit",
    driftSeconds: 22,
    tag: "Lab 04 · Monitoring",
    title: "Figure Sentry — a tiny stock watcher",
    aspect: "aspect-square",
    grow: "flex-1 basis-[240px]",
    opacity: "opacity-70",
  },
];
---

<!-- Scene 05 — the one horizontal moment. Desktop: vertical scroll drives the
     track sideways inside a sticky stage (scenes/labs.ts). Elsewhere: the grid. -->
<section id="labs" data-scene="labs" class="labs-scene relative border-t border-[#1e1e1c] bg-[#070707]">
  <div data-stage class="scene-stage labs-stage">
    <span data-labs-ghost aria-hidden="true" class="labs-ghost">Labs — 04</span>
    <div class="labs-inner mx-auto max-w-[1440px] px-5 py-16 sm:px-8 lg:px-16 lg:py-28">
      <div data-labs-bar class="flex flex-wrap items-baseline justify-between gap-6 font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
        <span class="text-paper">04 / Labs</span>
        <span>Work = proof. Labs = curiosity.</span>
      </div>

      <div class="labs-head flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
        <h2 data-labs-title class="mt-7 mb-0 max-w-[26ch] text-[clamp(24px,2.8vw,40px)] leading-[1.15] font-medium tracking-[-.03em] text-wrap-pretty lg:mt-10">
          The same systems I use to solve real problems, poked at for fun.
        </h2>
        <a data-labs-link href="/labs" class="labs-link inline-block border-b border-[#2b2b28] pb-2 font-mono text-[11.5px] tracking-[.12em] text-accent uppercase">
          All experiments →
        </a>
      </div>

      <div data-labs-track class="labs-track mt-9 flex flex-wrap gap-4 lg:mt-14">
        {labs.map((lab) => (
          <div data-lab class:list={["lab relative min-w-0 overflow-hidden border border-[#1e1e1c] bg-[#050505]", lab.aspect, lab.grow]}>
            <video
              src={`/videos/${lab.video}.mp4`}
              poster={`/videos/posters/${lab.video}.jpg`}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              class:list={["absolute inset-0 h-full w-full object-cover", lab.opacity]}
              style={`animation: hh-drift ${lab.driftSeconds}s ease-in-out infinite`}
            ></video>
            <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(7,7,7,.9),rgba(7,7,7,.15))]"></div>
            <div data-lab-caption class="absolute bottom-4 left-[18px] flex flex-col gap-[6px]">
              <span class="font-mono text-[10.5px] tracking-[.12em] text-[#9c9a94] uppercase">{lab.tag}</span>
              <span class="text-[16px] tracking-[-.015em]">{lab.title}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
