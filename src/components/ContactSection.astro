---
import ContactForm from "./ContactForm.astro";
---

<!-- Scene 07. Contact text is visible on arrival. A green corner box (overlay) sits
     at the bottom-right; as the user scrolls it expands to fill the stage, then
     two halves split apart to reveal the contact form underneath. -->
<section id="contact" data-scene="contact" class="contact-scene relative border-t border-[#1e1e1c]">
  <div data-contact-stage class="scene-stage">

    <!-- Contact text — visible from the start, fades as the overlay expands. -->
    <div data-contact-content class="contact-inner mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-16">
      <span data-contact-rule aria-hidden="true" class="contact-rule"></span>
      <div data-contact-reveal class="home-kicker font-mono tracking-[.14em] text-paper uppercase">06 / Contact</div>

      <h2 data-contact-title class="contact-title mt-8 max-w-[22ch] text-[clamp(30px,4.4vw,62px)] leading-[1.08] font-medium tracking-[-.035em] text-wrap-pretty lg:mt-11">
        Hiring, building, or stuck on something that should work. Start there.
      </h2>

      <div data-contact-reveal class="mt-8 flex flex-wrap items-center gap-[14px] lg:mt-13">
        <a
          href="mailto:hammadhb225@gmail.com"
          class="inline-flex items-center gap-[10px] rounded-[2px] bg-paper px-[26px] py-4 text-[15.5px] font-medium text-ink hover:bg-accent"
        >
          hammadhb225@gmail.com →
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-[10px] rounded-[2px] border border-[#2b2b28] px-[26px] py-4 text-[15.5px] text-[#cfcdc6] hover:border-[#5a5a54] hover:text-paper"
        >
          Download CV ↓
        </a>
        <div class="home-meta ml-2 flex gap-5 font-mono tracking-[.1em] uppercase">
          <a href="#" class="hover:text-accent">GitHub ↗</a>
          <a href="#" class="hover:text-accent">LinkedIn ↗</a>
        </div>
      </div>
    </div>

    <!-- Overlay — corner box (framed, labelled) → full screen → halves split → /contact. -->
    <div data-contact-overlay class="contact-overlay" aria-hidden="true">
      <div data-contact-half="left" class="contact-half-l"></div>
      <div data-contact-half="right" class="contact-half-r"></div>
      <span data-contact-label class="contact-label">Contact →</span>
    </div>

  </div>
</section>
