---
const items = [
  {
    title: "Product Engineering",
    body: "Building complete user-facing systems, not isolated screens.",
    stack: "Next.js · Supabase · Postgres",
  },
  {
    title: "Frontend & Interaction",
    body: "Complex UI, responsive systems, design implementation, interaction.",
    stack: "React · TypeScript · Motion",
  },
  {
    title: "Systems & Architecture",
    body: "Data flow, API boundaries, architecture, breaking points.",
    stack: "REST · Realtime · Auth · Queues",
  },
  {
    title: "Performance & Debugging",
    body: "Following problems through browsers, applications, servers, databases.",
    stack: "Linux · Nginx · Profiling · SEO",
  },
];
---

<!-- Scene 03. Desktop: a sticky stage where scroll steps through each discipline
     (src/scripts/scenes/capabilities.ts). Elsewhere: the original card grid. -->
<section data-scene="capabilities" class="caps-scene relative z-[3] border-t border-[#1e1e1c] bg-ink">
  <div data-stage class="scene-stage caps-stage">
    <div class="caps-inner mx-auto max-w-[1440px] px-5 py-16 sm:px-8 lg:px-16 lg:py-28">
      <div data-caps-bar class="flex flex-wrap items-baseline justify-between gap-6 font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
        <span class="text-paper">02 / Capabilities</span>
        <span>Engineering domains</span>
      </div>

      <ol class="caps-list m-0 mt-9 grid list-none grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-6 p-0 lg:mt-14 lg:gap-11">
        {items.map((item, i) => (
          <li data-cap class="cap relative flex flex-col gap-3 border-t border-[#2b2b28] pt-[22px]">
            <span class="cap-num font-mono text-[10.5px] text-[#6e6c67]">{String(i + 1).padStart(2, "0")}</span>
            <span class="cap-title text-[clamp(17px,1.5vw,21px)] tracking-[-.02em]">{item.title}</span>
            <span class="cap-detail flex flex-col gap-3">
              <span class="cap-body m-0 text-sm leading-[1.65] text-[#a7a59e]">{item.body}</span>
              <span class="mt-1 font-mono text-[10.5px] tracking-[.06em] text-[#6e6c67]">{item.stack}</span>
            </span>
            <span data-cap-rule aria-hidden="true" class="cap-rule"></span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
