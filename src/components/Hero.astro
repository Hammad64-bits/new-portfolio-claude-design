---
interface Props {
  heroHoldMs?: number;
}

const { heroHoldMs = 4000 } = Astro.props;

const lines = [
  "Building products. Solving whatever breaks between idea and production.",
  "I build software that has to actually work.",
  "Polished interfaces, messy systems, production problems — I follow them wherever they lead.",
];
---

<!--
  Scene 01. On desktop (see "Scroll scenes" in global.css) this section is a tall
  scroll track and [data-stage] is a sticky 100svh composition whose timeline
  lives in src/scripts/scenes/hero.ts. Everywhere else it is the plain layout.
-->
<section id="top" data-scene="hero" class="hero-scene relative">
  <div data-stage class="scene-stage hero-stage">
    <div
      class="hero-grid mx-auto grid max-w-[1440px] grid-cols-[repeat(auto-fit,minmax(340px,1fr))] items-start gap-x-10 gap-y-16 px-5 py-14 sm:px-8 sm:py-24 lg:px-16 lg:py-28"
    >
      <div class="hero-copy min-w-0">
        <div data-hero-eyebrow class="flex items-center gap-[14px] font-mono text-[11.5px] tracking-[.14em] text-[#8c8a84] uppercase">
          <span class="block h-px w-[26px] bg-[#3a3a36]"></span>
          <span>Software Engineer · Frontend Edge</span>
        </div>

        <h1
          data-hero-lines
          data-hold-ms={heroHoldMs}
          data-step="0"
          class="hero-title relative mt-[26px] h-[280px] text-[clamp(30px,4.6vw,60px)] leading-[1.06] font-medium tracking-[-.035em] text-wrap-pretty sm:h-[320px] lg:h-[344px]"
        >
          {lines.map((line, i) => (
            <span class:list={["hero-line", `hero-line-${i}`]}>{line}</span>
          ))}
        </h1>

        <p data-hero-copy class="m-0 max-w-[52ch] text-[clamp(15px,1.2vw,17.5px)] leading-[1.65] text-[#a7a59e] text-wrap-pretty">
          I'm Hammad, a software engineer with deep frontend experience. I work across product, architecture and systems to turn ideas into software people can actually use.
        </p>

        <div data-hero-copy class="hero-actions mt-[38px] flex flex-wrap gap-[14px]">
          <a
            href="#work"
            class="inline-flex items-center gap-[10px] rounded-[2px] bg-paper px-[22px] py-[14px] text-[14.5px] font-medium text-ink hover:bg-accent"
          >
            Explore my work →
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-[10px] rounded-[2px] border border-[#2b2b28] px-[22px] py-[14px] text-[14.5px] text-[#cfcdc6] hover:border-[#5a5a54] hover:text-paper"
          >
            Download CV ↓
          </a>
        </div>

        <div data-hero-copy class="hero-status mt-11 flex items-center gap-[10px] font-mono text-[11.5px] tracking-[.06em] text-[#8c8a84]">
          <span class="block h-[6px] w-[6px] rounded-full bg-accent" style="animation: hh-blink 2.4s infinite"></span>
          <span>Currently building at SolvoLab · Pakistan</span>
        </div>
      </div>

      <div class="hero-media flex min-w-0 flex-col gap-3">
        <!-- The frame clips the canvas. In the cinematic scene the canvas is stretched
             to the stage and the frame's clip-path opens outward to full bleed. -->
        <div data-hero-frame class="hero-frame relative aspect-4/5 overflow-hidden border border-[#1e1e1c] bg-[#050505]">
          <div data-hero-canvas class="hero-canvas absolute inset-0">
            <div data-hero-depth class="absolute inset-0">
              <video
                src="/videos/glowing_cubes.mp4"
                poster="/videos/posters/glowing_cubes.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                class="absolute inset-0 h-full w-full object-cover opacity-85"
                style="animation: hh-drift 22s ease-in-out infinite"
              ></video>
            </div>
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(10,10,10,.35),rgba(10,10,10,.05)_40%,rgba(10,10,10,.6))]"></div>
            <div data-hero-dim class="hero-dim absolute inset-0 bg-ink"></div>
          </div>
          <div data-hero-decor class="absolute top-4 left-4 font-mono text-[10.5px] tracking-[.12em] text-[#cfcdc6] uppercase">
            Video / loop_01 · particles
          </div>
          <div data-hero-dots data-hero-decor data-step="0" class="absolute bottom-4 left-4 flex gap-[6px]">
            <span class="hero-dot hero-dot-0"></span>
            <span class="hero-dot hero-dot-1"></span>
            <span class="hero-dot hero-dot-2"></span>
          </div>
        </div>
        <div data-hero-decor class="hero-caption font-mono text-[10.5px] tracking-[.1em] text-[#6e6c67] uppercase">
          Motion supports the headline. It never covers it.
        </div>
      </div>
    </div>

    <!-- Hand-off into Scene 02. Decorative: the real "01 / Selected Work" label
         lives in Work.astro; this is the title card that introduces it. -->
    <div data-hero-next aria-hidden="true" class="hero-next">
      <div class="mx-auto flex h-full max-w-[1440px] flex-col justify-end px-16 pb-[9svh]">
        <div class="hero-next-meta flex justify-between font-mono text-[11.5px] tracking-[.14em] text-[#cfcdc6] uppercase">
          <span class="mask-line"><span data-next-meta class="text-paper">01 / Selected Work</span></span>
          <span class="mask-line"><span data-next-meta>Two projects · 2023—2025</span></span>
        </div>
        <div data-next-title class="hero-next-title">Selected Work</div>
      </div>
    </div>

    <div data-hero-cue aria-hidden="true" class="hero-cue font-mono text-[10.5px] tracking-[.14em] text-[#6e6c67] uppercase">
      <span>Scroll</span><span class="hero-cue-line"></span>
    </div>
  </div>
</section>
