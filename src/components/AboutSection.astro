<!-- Scene 06. Subtle: photographs drift inside their frames (scenes/about.ts). -->
<section id="about" data-scene="about" class="mx-auto max-w-[1440px] border-t border-[#1e1e1c] px-5 py-16 sm:px-8 lg:px-16 lg:py-28">
  <div data-about-reveal class="home-kicker font-mono tracking-[.14em] text-paper uppercase">05 / About</div>

  <div class="mt-9 flex flex-wrap items-start gap-7 lg:mt-14 lg:gap-16">
    <div data-about-reveal class="flex min-w-0 max-w-[380px] flex-1 basis-[260px] flex-col gap-3">
      <div data-about-frame class="relative texture-hatch flex aspect-4/5 items-end justify-center overflow-hidden border border-[#1e1e1c] p-4 text-center">
        <span class="home-caption z-10 bg-ink/85 px-2 py-1 font-mono tracking-[.1em] uppercase">Portrait / Hammad</span>
        <div data-about-photo class="absolute inset-0">
          <img src="/images/git_profile.png" alt="Illustrated portrait of Hammad" class="absolute inset-0 h-full w-full object-scale-down" />
        </div>
      </div>
    </div>

    <div class="flex min-w-0 flex-1 basis-[420px] flex-col gap-[22px] lg:flex-[2]">
      <p data-about-reveal class="m-0 max-w-[44ch] text-[clamp(17px,1.7vw,24px)] leading-[1.5] tracking-[-.02em] text-[#dedbd4] text-wrap-pretty">
        I like computers more than is strictly reasonable. Linux, systems, why things are slow, why things break.
      </p>
      <p data-about-reveal class="home-body m-0 max-w-[52ch]">
        Outside of work I shoot photography, explore the tools I use every day, and keep a running list of experiments to try.
      </p>

      <div data-about-reveal class="mt-[6px] flex flex-wrap gap-4">
        <div data-about-frame class="relative min-w-0 flex-1 basis-[200px] overflow-hidden border border-[#1e1e1c] bg-[#050505] aspect-16/10">
          <div data-about-photo class="absolute inset-0">
          <video
            src="/videos/smoker.mp4"
            poster="/videos/posters/smoker.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            class="absolute inset-0 h-full w-full object-cover opacity-90"
            style="animation: hh-drift 24s ease-in-out infinite"
          ></video>
          </div>
          <span class="home-caption absolute bottom-[10px] left-3 font-mono tracking-[.1em] uppercase">Video / sketch loop</span>
        </div>
        <div data-about-frame class="relative texture-hatch flex min-w-0 flex-1 basis-[200px] items-end justify-end overflow-hidden border border-[#1e1e1c] aspect-16/10 pb-2.5 pr-2.5">
          <span class="home-caption z-10 font-mono tracking-[.1em] uppercase">Photo — desk / setup</span>
          <!-- <img src="/images/black_laptop.jpg" alt="Desk / setup" class="absolute inset-0 h-full w-full object-cover" /> -->

          <div data-about-photo class="absolute inset-0">
            <img src="/images/laptop_code.jpg" alt="Desk / setup" class="absolute inset-0 h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
